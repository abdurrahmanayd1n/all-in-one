<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="780" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#1B1C23" Foreground="#F2F3F5" FontSize="13"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
  <Window.Resources>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#33353F"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="face" Background="{TemplateBinding Background}" CornerRadius="9" BorderThickness="1.5" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="White"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="face" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented choice -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6E7EB"/>
      <Setter Property="Margin" Value="0,0,5,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="face" Background="#2A2C35" CornerRadius="8" Padding="7.5,6" BorderThickness="1.5" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Background" Value="#363945"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="face" Property="Background" Value="#0A84FF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="#0A84FF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="face" Background="#121319" CornerRadius="8" BorderThickness="1" BorderBrush="#3A3C47" Padding="8,7">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="#0A84FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="face" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6E7EB"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="38" Height="22" CornerRadius="11" Background="#3A3C47" BorderThickness="1.5" BorderBrush="Transparent">
                <Ellipse x:Name="thumb" Width="15" Height="15" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                  <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#0A84FF"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0:0:0.16"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One picture of a batch -->
    <Style x:Key="Thumb" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="face" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Padding="2" Background="#1B1C23" MinWidth="52" Height="58">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="#4A4D5A"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="#0A84FF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" Height="22"><Border Height="5" CornerRadius="2.5" Background="{TemplateBinding Background}"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="#0A84FF" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="#3A3C47" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Ellipse x:Name="knob" Width="18" Height="18" Fill="White" Stroke="#40000000"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PART_Track" Property="Effect"><Setter.Value><DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="8"/></Setter.Value></Setter></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Only shown when a small screen shrinks the window -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4A4D5A" CornerRadius="3"/></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="6"/>
          <Setter Property="MinHeight" Value="6"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4A4D5A" CornerRadius="3"/></ControlTemplate></Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A6A9B4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Page">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="356"/>
    </Grid.ColumnDefinitions>

    <!-- Right: settings -->
    <DockPanel Grid.Column="1" Margin="24,20,12,22">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,12,18">
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="Details" Foreground="#A6A9B4" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,0,12,0">
        <TextBlock x:Name="Error" Foreground="#FF8A80" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <ProgressBar x:Name="Progress" Height="6" Maximum="1" Margin="0,0,0,12" Foreground="#0A84FF" Background="#3A3C47"
                     BorderThickness="0" Visibility="Collapsed" AutomationProperties.Name="İlerleme"/>
        <DockPanel>
          <Button x:Name="Cancel" DockPanel.Dock="Right" Content="İptal" IsCancel="True" Margin="10,0,0,0"/>
          <Button x:Name="Extra" DockPanel.Dock="Right" Visibility="Collapsed" IsEnabled="False" Margin="10,0,0,0" Padding="14,9"/>
          <Button x:Name="Save" Content="Kaydet" IsDefault="True" Background="#0A84FF" FontWeight="SemiBold" IsEnabled="False"/>
        </DockPanel>
      </StackPanel>

      <Grid>
      <!-- Text taken from a picture -->
      <DockPanel x:Name="ReaderPanel" Margin="0,0,12,12" Visibility="Collapsed">
        <StackPanel x:Name="LanguagePanel" DockPanel.Dock="Top" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Label}" Text="Dil"/>
          <WrapPanel x:Name="LanguageChips" Margin="0,0,0,6"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Text="Metin (düzeltebilir, bir kısmını seçip Ctrl+C ile alabilirsin)" TextWrapping="Wrap"/>
        <TextBox x:Name="Recognized" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Tanınan metin"/>
      </DockPanel>

      <!-- Renaming many files -->
      <ScrollViewer x:Name="Renaming" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Style="{StaticResource Label}" Text="Yeni ad (uzantı değişmez)"/>
          <TextBox x:Name="PatternBox" Text="{}{ad}" MaxLength="200" Margin="0,0,0,8" AutomationProperties.Name="Yeni ad"/>
          <WrapPanel x:Name="TokenButtons" Margin="0,0,0,10"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="Eski adda bul"/><TextBox x:Name="FindBox" MaxLength="100"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Şununla değiştir"/><TextBox x:Name="ReplaceBox" MaxLength="100"/></StackPanel>
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource Label}" Text="Numara başlangıcı"/><TextBox x:Name="StartBox" Text="1" MaxLength="7"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="En az basamak"/><TextBox x:Name="DigitsBox" Text="2" MaxLength="1"/></StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource Label}" Text="Harfler"/>
          <WrapPanel x:Name="CaseChips" Margin="0,0,0,6"/>
          <TextBlock Style="{StaticResource Label}" Text="Numaralama sırası"/>
          <WrapPanel x:Name="OrderChips" Margin="0,0,0,6"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Application settings; every change applies at once -->
      <ScrollViewer x:Name="Preferences" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel Margin="0,0,12,0">
          <DockPanel>
            <TextBlock x:Name="HoldValue" DockPanel.Dock="Right" Style="{StaticResource Label}"/>
            <TextBlock Style="{StaticResource Label}" Text="Menü açılma süresi"/>
          </DockPanel>
          <Slider x:Name="HoldSlider" Minimum="150" Maximum="1000" SmallChange="25" LargeChange="100" TickFrequency="25"
                  IsSnapToTickEnabled="True" Margin="0,0,0,8" AutomationProperties.Name="Menü açılma süresi"/>
          <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"
                     Text="Sol Alt bu kadar basılı tutulunca menü açılır. Çok kısa süre Alt kısayollarıyla karışabilir."/>
          <CheckBox x:Name="Autostart" Content="Bilgisayar açılınca başlat" Margin="0,0,0,12"/>
          <CheckBox x:Name="ShowPicker" Content="Renk seçici simgesini göster" Margin="0,0,0,16"/>
          <Border Height="1" Background="#2E303A" Margin="0,0,0,16"/>
          <CheckBox x:Name="FixedSuffix" Content="Her dosyaya sabit ek ekle" Margin="0,0,0,10"/>
          <TextBox x:Name="FixedSuffixBox" MaxLength="60" AutomationProperties.Name="Sabit ek"/>
          <TextBlock x:Name="FixedSuffixHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <Border Height="1" Background="#2E303A" Margin="0,16,0,16"/>
          <Button x:Name="Uninstall" Content="Uygulamayı kaldır…" HorizontalAlignment="Left" Padding="14,9"/>
        </StackPanel>
      </ScrollViewer>

      <!-- The scroll bar sits in the panel's right margin so it never covers a control -->
      <ScrollViewer x:Name="Settings" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
        <StackPanel Margin="0,0,12,0">
          <StackPanel x:Name="MethodPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Yöntem"/>
            <WrapPanel x:Name="MethodChips" Margin="0,0,0,8"/>
            <TextBlock x:Name="MethodHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,14"/>
          </StackPanel>

          <StackPanel x:Name="TargetPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="En fazla (KB)"/>
            <TextBox x:Name="TargetBox" MaxLength="7" Text="500" Margin="0,0,0,10"/>
            <WrapPanel x:Name="TargetChips" Margin="0,0,0,8"/>
          </StackPanel>

          <!-- A saved recipe and its values -->
          <StackPanel x:Name="PresetPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Hazır ayar"/>
            <WrapPanel x:Name="PresetChips" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Style="{StaticResource Label}" Text="En uzun kenar (px, 0: aynı)"/><TextBox x:Name="PresetSideBox" MaxLength="5"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="En fazla KB (0: sınırsız)"/><TextBox x:Name="PresetLimitBox" MaxLength="7"/></StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Label}" Text="Ayar adı"/>
            <DockPanel Margin="0,0,0,12">
              <Button x:Name="PresetDelete" DockPanel.Dock="Right" Content="Sil" Padding="12,6" Margin="6,0,0,0" ToolTip="Bu addaki hazır ayarı sil"/>
              <Button x:Name="PresetStore" DockPanel.Dock="Right" Content="Ayarı sakla" Padding="12,6" Margin="8,0,0,0" ToolTip="Bu değerleri bu adla sakla"/>
              <TextBox x:Name="PresetNameBox" MaxLength="20" AutomationProperties.Name="Ayar adı"/>
            </DockPanel>
          </StackPanel>

          <!-- Archive of files and folders -->
          <StackPanel x:Name="ZipLevelPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Sıkıştırma"/>
            <WrapPanel x:Name="ZipLevelChips" Margin="0,0,0,6"/>
          </StackPanel>

          <!-- Video tools -->
          <StackPanel x:Name="VideoCompressPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Kalite"/>
            <WrapPanel x:Name="VideoQualityChips" Margin="0,0,0,6"/>
            <StackPanel x:Name="VideoTargetPanel" Visibility="Collapsed">
              <TextBlock Style="{StaticResource Label}" Text="En fazla (MB)"/>
              <TextBox x:Name="VideoTargetBox" MaxLength="6" Text="25" Margin="0,0,0,12"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="Çözünürlük (kısa kenar)"/>
            <WrapPanel x:Name="VideoSizeChips" Margin="0,0,0,6"/>
            <CheckBox x:Name="VideoMute" Content="Sesi kaldır" Margin="0,0,0,14"/>
          </StackPanel>
          <StackPanel x:Name="VideoGifPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Style="{StaticResource Label}" Text="Başlangıç (sn, dk:sn)"/><TextBox x:Name="GifStartBox" MaxLength="10" Text="0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Süre (sn, 0: sonuna kadar)"/><TextBox x:Name="GifLengthBox" MaxLength="10" Text="5"/></StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Label}" Text="Genişlik (px)"/>
            <WrapPanel x:Name="GifWidthChips" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Label}" Text="Saniyedeki kare"/>
            <WrapPanel x:Name="GifRateChips" Margin="0,0,0,6"/>
          </StackPanel>
          <StackPanel x:Name="VideoAudioPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Ses biçimi"/>
            <WrapPanel x:Name="AudioChips" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Videonun sesi AAC ise M4A kalite kaybı olmadan alınır."/>
          </StackPanel>

          <StackPanel x:Name="FormatPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Yeni biçim"/>
            <WrapPanel x:Name="FormatChips" Margin="0,0,0,8"/>
          </StackPanel>

          <StackPanel x:Name="ScalePanel" Visibility="Collapsed">
            <DockPanel>
              <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Style="{StaticResource Label}"/>
              <TextBlock Style="{StaticResource Label}" Text="Ölçek"/>
            </DockPanel>
            <Slider x:Name="ScaleSlider" Minimum="1" Maximum="200" Value="50" SmallChange="1" LargeChange="10" Margin="0,0,0,12"/>
            <WrapPanel x:Name="ScaleChips" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Style="{StaticResource Label}" Text="Genişlik (px)"/><TextBox x:Name="WidthBox" MaxLength="5"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Yükseklik (px)"/><TextBox x:Name="HeightBox" MaxLength="5"/></StackPanel>
            </Grid>
            <CheckBox x:Name="LockRatio" Content="Oranı koru" IsChecked="True" Margin="0,0,0,14"/>
          </StackPanel>

          <StackPanel x:Name="CropPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Şekil"/>
            <WrapPanel x:Name="ShapeChips" Margin="0,0,0,6"/>
            <StackPanel x:Name="RoundPanel" Visibility="Collapsed">
              <DockPanel>
                <TextBlock x:Name="RoundValue" DockPanel.Dock="Right" Style="{StaticResource Label}"/>
                <TextBlock Style="{StaticResource Label}" Text="Köşe yuvarlaklığı"/>
              </DockPanel>
              <Slider x:Name="RoundSlider" Minimum="1" Maximum="50" Value="15" SmallChange="1" LargeChange="5" Margin="0,0,0,12"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="En-boy oranı"/>
            <WrapPanel x:Name="AspectChips" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/>
                <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel><TextBlock Style="{StaticResource Label}" Text="X"/><TextBox x:Name="CropX" MaxLength="5"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Y"/><TextBox x:Name="CropY" MaxLength="5"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource Label}" Text="Genişlik"/><TextBox x:Name="CropW" MaxLength="5"/></StackPanel>
              <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource Label}" Text="Yükseklik"/><TextBox x:Name="CropH" MaxLength="5"/></StackPanel>
            </Grid>
            <WrapPanel Margin="0,0,0,8">
              <Button x:Name="TurnLeft" Content="↺" ToolTip="Sola döndür" AutomationProperties.Name="Sola döndür" Width="34" Padding="0,4" FontSize="16" Margin="0,0,6,0"/>
              <Button x:Name="TurnRight" Content="↻" ToolTip="Sağa döndür" AutomationProperties.Name="Sağa döndür" Width="34" Padding="0,4" FontSize="16" Margin="0,0,6,0"/>
              <Button x:Name="TurnMirror" Content="⇆" ToolTip="Yatay aynala" AutomationProperties.Name="Yatay aynala" Width="34" Padding="0,4" FontSize="16" Margin="0,0,6,0"/>
              <Button x:Name="TurnFlip" Content="⇅" ToolTip="Dikey aynala" AutomationProperties.Name="Dikey aynala" Width="34" Padding="0,4" FontSize="16" Margin="0,0,14,0"/>
              <Button x:Name="CropCenter" Content="Ortala" Padding="10,6" Margin="0,0,6,0"/>
              <Button x:Name="CropAll" Content="Tümü" ToolTip="En büyük alanı seç" Padding="10,6"/>
            </WrapPanel>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                       Text="Tutamaçla boyutlandır, içinden taşı. Ok tuşları taşır, Ctrl+ok boyutlandırır (Shift: 10 px)."/>
          </StackPanel>

          <StackPanel x:Name="QualityPanel" Visibility="Collapsed">
            <DockPanel>
              <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Style="{StaticResource Label}"/>
              <TextBlock Style="{StaticResource Label}" Text="Kalite"/>
            </DockPanel>
            <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="70" SmallChange="1" LargeChange="10" Margin="0,0,0,12"/>
            <WrapPanel x:Name="QualityChips" Margin="0,0,0,8"/>
          </StackPanel>

          <Border Height="1" Background="#2E303A" Margin="0,4,0,16"/>

          <!-- Several files: one by one, or together in an archive -->
          <StackPanel x:Name="OutputPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Kayıt şekli"/>
            <WrapPanel x:Name="OutputChips" Margin="0,0,0,6"/>
            <StackPanel x:Name="ZipPanel" Visibility="Collapsed">
              <TextBlock Style="{StaticResource Label}" Text="ZIP adı"/>
              <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right" Text=".zip" Foreground="#A6A9B4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="ZipBox" MaxLength="200" Text="gorseller"/>
              </DockPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock x:Name="NameLabel" Style="{StaticResource Label}" TextWrapping="Wrap" Text="Dosya adı"/>
          <DockPanel Margin="0,0,0,16">
            <TextBlock x:Name="Extension" DockPanel.Dock="Right" Foreground="#A6A9B4" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox x:Name="NameBox" MaxLength="200"/>
          </DockPanel>
          <CheckBox x:Name="UseSuffix" Content="Her dosyaya sabit ek ekle" Margin="0,0,0,10"/>
          <TextBox x:Name="SuffixBox" MaxLength="60" ToolTip="Örnek: _web"/>
          <TextBlock x:Name="SuffixHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </DockPanel>

    <!-- Left: preview -->
    <Border Grid.Column="0" Background="#101116">
      <DockPanel>
      <!-- Shown when several files are selected -->
      <StackPanel x:Name="BatchBar" DockPanel.Dock="Bottom" Margin="24,0,24,16" Visibility="Collapsed">
        <TextBlock x:Name="Current" Foreground="#A6A9B4" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Strip" Orientation="Horizontal" Margin="0,0,0,6"/>
        </ScrollViewer>
      </StackPanel>
      <!-- What saving will change: the original on top, the result under it -->
      <Border x:Name="Info" DockPanel.Dock="Bottom" Margin="24,0,24,16" Padding="16,12" CornerRadius="12" Background="#1B1C23" Visibility="Collapsed">
        <StackPanel>
          <Grid x:Name="Values">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Foreground="#A6A9B4" FontSize="11" Text="Dosya boyutu"/>
              <TextBlock x:Name="SizeBefore" Foreground="#A6A9B4" Margin="0,3,0,0"/>
              <TextBlock x:Name="SizeAfter" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Foreground="#A6A9B4" FontSize="11" Text="Çözünürlük"/>
              <TextBlock x:Name="DimensionsBefore" Foreground="#A6A9B4" Margin="0,3,0,0"/>
              <TextBlock x:Name="DimensionsAfter" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Foreground="#A6A9B4" FontSize="11" Text="Biçim"/>
              <TextBlock x:Name="KindBefore" Foreground="#A6A9B4" Margin="0,3,0,0"/>
              <TextBlock x:Name="KindAfter" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel x:Name="QualityInfo" Grid.Column="3">
              <TextBlock Foreground="#A6A9B4" FontSize="11" Text="Kalite"/>
              <TextBlock Foreground="#A6A9B4" Margin="0,3,0,0" Text=" "/>
              <TextBlock x:Name="QualityAfter" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="Result" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock x:Name="Note" Foreground="#A6A9B4" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <!-- Several files: what saving all of them will change -->
          <Border x:Name="TotalBar" BorderBrush="#2E303A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,9,0,0" Visibility="Collapsed">
            <TextBlock x:Name="Total" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>
      <Grid x:Name="Stage" Margin="24">
        <TextBlock x:Name="Loading" Text="Yükleniyor…" Foreground="#A6A9B4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- Old and new names -->
        <ScrollViewer x:Name="RenameList" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="Rows" Margin="0,0,8,0"/>
        </ScrollViewer>
        <!-- Shown by the settings window -->
        <StackPanel x:Name="About" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <Image x:Name="AboutIcon" Width="96" Height="96" Margin="0,0,0,18"/>
          <TextBlock Text="All In One" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
          <TextBlock Foreground="#A6A9B4" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21"
                     Text="Dosya gezgininde veya masaüstünde dosya seç, sonra Sol Alt tuşunu basılı tut. Birden fazla dosya için Ctrl ile tıkla. Ekranın herhangi bir yerindeki metni almak için Alt+Q (veya Win+Shift+O), bir tabloyu sütunlarıyla almak için Alt+T, öndeki pencereyi üstte tutmak için Win+Shift+U, biçimsiz yapıştırmak için Win+Shift+Y, harf çevirip yapıştırmak için Win+Shift+B."/>
        </StackPanel>
        <Grid x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Checkerboard: shows where the picture is transparent -->
          <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
              <DrawingBrush.Drawing>
                <DrawingGroup>
                  <GeometryDrawing Brush="#2A2B31" Geometry="M0,0 H20 V20 H0 Z"/>
                  <GeometryDrawing Brush="#3A3B43" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z"/>
                </DrawingGroup>
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Grid.Background>
          <Image x:Name="Preview" Stretch="Fill"/>
          <!-- Before / after: the original left of the divider, the result right of it -->
          <Image x:Name="Original" Stretch="Fill" Visibility="Collapsed"/>
          <Canvas x:Name="Compare" Background="Transparent" Cursor="SizeWE" Focusable="True" Visibility="Collapsed"
                  ToolTip="Sürükle veya ok tuşlarıyla kaydır">
            <Line x:Name="Divider" Stroke="White" StrokeThickness="2"/>
            <Border x:Name="Handle" Width="30" Height="30" CornerRadius="15" Background="#CC1B1C23" BorderBrush="White" BorderThickness="1.5">
              <TextBlock Text="◂▸" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Canvas.Left="8" Canvas.Top="8" Background="#B0000000" CornerRadius="6" Padding="8,3">
              <TextBlock Text="Önce" FontSize="11" Foreground="White"/>
            </Border>
            <Border x:Name="AfterTag" Canvas.Top="8" Background="#B0000000" CornerRadius="6" Padding="8,3">
              <TextBlock Text="Sonra" FontSize="11" Foreground="White"/>
            </Border>
          </Canvas>
          <!-- Crop area: not clipped, so the handles stay whole at the edges of the picture -->
          <Canvas x:Name="Selection" Background="Transparent" Cursor="Cross" Visibility="Collapsed" Focusable="True">
            <Path x:Name="Shade" Fill="#99000000"/>
            <Path x:Name="Thirds" Stroke="#66FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
            <Path x:Name="ShapeOutline" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False"/>
            <Rectangle x:Name="Outline" Stroke="#99FFFFFF" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False"/>
            <Path x:Name="Handles" Fill="White" Stroke="#99000000" StrokeThickness="1"/>
          </Canvas>
        </Grid>
      </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
