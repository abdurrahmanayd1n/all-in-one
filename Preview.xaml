<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All In One - Önizleme" Width="1120" Height="740" MinWidth="640" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#191919" Foreground="#F2F2F2" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Glyph" TargetType="Button">
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="face" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Background" Value="#404040"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#5A5A5A" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#5A5A5A" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="Page">
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <!-- The tab and the window buttons -->
    <DockPanel Background="#1C1C1C">
      <Button x:Name="Close" DockPanel.Dock="Right" Style="{StaticResource Glyph}" Content="&#xE8BB;" FontSize="11" Margin="0,0,6,0" AutomationProperties.Name="Kapat"/>
      <Button x:Name="Grow" DockPanel.Dock="Right" Style="{StaticResource Glyph}" Content="&#xE922;" FontSize="11" AutomationProperties.Name="Büyüt"/>
      <Border HorizontalAlignment="Left" Background="#2B2B2B" CornerRadius="8,8,0,0" Margin="10,7,10,0" Padding="12,0,14,0" MaxWidth="460">
        <DockPanel>
          <Image x:Name="TabIcon" DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,9,0"/>
          <TextBlock x:Name="TabName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </DockPanel>

    <!-- Back and forward among the selected items, and where the item is -->
    <DockPanel Grid.Row="1" Background="#2B2B2B">
      <Button x:Name="Previous" Style="{StaticResource Glyph}" Content="&#xE72B;" Margin="10,0,2,0" AutomationProperties.Name="Önceki"/>
      <Button x:Name="Next" Style="{StaticResource Glyph}" Content="&#xE72A;" Margin="0,0,10,0" AutomationProperties.Name="Sonraki"/>
      <Border Background="#383838" CornerRadius="6" Margin="0,8,12,8" Padding="12,0">
        <TextBlock x:Name="Address" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Border>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PlacesColumn" Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="FactsColumn" Width="250"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#202020">
        <StackPanel x:Name="Places" Margin="8,10"/>
      </ScrollViewer>
      <Grid x:Name="Body" Grid.Column="1" Background="#191919"/>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="#202020">
        <StackPanel Margin="18,20">
          <Image x:Name="BigIcon" Width="96" Height="96" Margin="0,0,0,14"/>
          <TextBlock x:Name="ItemName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock x:Name="Kind" Foreground="#A8A8A8" TextAlignment="Center" Margin="0,4,0,16" TextWrapping="Wrap"/>
          <Border Height="1" Background="#3A3A3A" Margin="0,0,0,12"/>
          <StackPanel x:Name="Facts"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <DockPanel Grid.Row="3" Background="#2B2B2B">
      <TextBlock x:Name="Hint" DockPanel.Dock="Right" Foreground="#A8A8A8" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <TextBlock x:Name="Count" FontSize="12" VerticalAlignment="Center" Margin="14,0"/>
    </DockPanel>
  </Grid>
</Window>
